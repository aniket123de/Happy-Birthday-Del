{
  "name": "birthday-gallery",
  "version": "1.0.0",
  "description": "An interactive birthday card with photo gallery and animations",
  "main": "index.js",
  "devDependencies": {
    "browser-sync": "^2.18.13",
    "run-script-os": "^1.1.6"
  },
  "scripts": {
    "start": "run-script-os",
    "start:win32": "browser-sync start --server --files '**/*.css, **/*.html, **/*.js, !node_modules/**/*' --port 7777 --browser \"C:\\Program Files\\Firefox Developer Edition\\firefox.exe\" --no-open",
    "//": "Hello! If you are having trouble running this command. Try changing Firefox Developer Edition to FirefoxDeveloperEdition",
    "start:darwin:linux": "browser-sync start --server --files '**/*.css, **/*.html, **/*.js, !node_modules/**/*' --port 7777 --no-open",
    "test": "echo \"Error: no test specified\" && exit 1"
  },  "repository": {
    "type": "git",
    "url": "git+https://github.com/aniket123de/Birthday_Del.git"
  },
  "keywords": [
    "birthday",
    "gallery",
    "animation",
    "gsap",
    "interactive"
  ],
